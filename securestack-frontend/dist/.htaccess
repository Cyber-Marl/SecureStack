# Block access to sensitive system, environment, and database files
<FilesMatch "^(\.env|\.git|db\.sqlite|.*\.sqlite3|.*\.py|.*\.sh|.*\.log|diagnose\.php|reset_super\.php|delete_diagnose\.php|deploy_wsgi\.php)">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
  </IfModule>
</FilesMatch>

# React SPA Routing
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  RewriteRule ^api - [L]
  RewriteRule ^admin - [L]
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME} !-l
  RewriteRule . /index.html [L]
</IfModule>

# Never cache index.html — always serve fresh to pick up new JS/CSS filenames
<FilesMatch "^index\.html$">
  Header set Cache-Control "no-cache, no-store, must-revalidate"
  Header set Pragma "no-cache"
  Header set Expires "0"
</FilesMatch>

# Cache static assets for 1 year (they have content-hashed filenames)
<FilesMatch "\.(js|css|png|svg|ico|woff|woff2|ttf)$">
  Header set Cache-Control "public, max-age=31536000, immutable"
</FilesMatch>
